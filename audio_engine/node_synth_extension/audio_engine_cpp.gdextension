[configuration]

entry_symbol = "synth_init"
compatibility_minimum = "4.7"
reloadable = true

[libraries]

macos.debug = "res://audio_engine/node_synth_extension/bin/libsynth.macos.template_debug.framework"
macos.release = "res://audio_engine/node_synth_extension/bin/libsynth.macos.template_release.framework"
ios.debug = "res://audio_engine/node_synth_extension/bin/libsynth.ios.template_debug.xcframework"
ios.release = "res://synth_cpp/bin/libsynth.ios.template_release.xcframework"
windows.debug.x86_32 = "res://audio_engine/node_synth_extension/bin/libsynth.windows.template_debug.x86_32.dll"
windows.release.x86_32 = "res://audio_engine/node_synth_extension/bin/libsynth.windows.template_release.x86_32.dll"
windows.debug.x86_64 = "res://audio_engine/node_synth_extension/bin/libsynth.windows.template_debug.x86_64.dll"
windows.release.x86_64 = "res://audio_engine/node_synth_extension/bin/libsynth.windows.template_release.x86_64.dll"
linux.debug.x86_64 = "res://audio_engine/node_synth_extension/bin/libsynth.linux.template_debug.x86_64.so"
linux.release.x86_64 = "res://audio_engine/node_synth_extension/bin/libsynth.linux.template_release.x86_64.so"
linux.debug.arm64 = "res://audio_engine/node_synth_extension/bin/libsynth.linux.template_debug.arm64.so"
linux.release.arm64 = "res://audio_engine/node_synth_extension/bin/libsynth.linux.template_release.arm64.so"
linux.debug.rv64 = "res://audio_engine/node_synth_extension/bin/libsynth.linux.template_debug.rv64.so"
linux.release.rv64 = "res://audio_engine/node_synth_extension/bin/libsynth.linux.template_release.rv64.so"
android.debug.x86_64 = "res://audio_engine/node_synth_extension/bin/libsynth.android.template_debug.x86_64.so"
android.release.x86_64 = "res://audio_engine/node_synth_extension/bin/libsynth.android.template_release.x86_64.so"
android.debug.arm64 = "res://audio_engine/node_synth_extension/bin/libsynth.android.template_debug.arm64.so"
android.release.arm64 = "res://audio_engine/node_synth_extension/bin/libsynth.android.template_release.arm64.so"

[dependencies]
ios.debug = {
	"res://audio_engine/node_synth_extension/bin/libgodot-cpp.ios.template_debug.xcframework": ""
}
ios.release = {
	"res://audio_engine/node_synth_extension/bin/libgodot-cpp.ios.template_release.xcframework": ""
}
