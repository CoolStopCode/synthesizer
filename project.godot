; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="midi-make"
run/main_scene="uid://ba4k64p5yr2mo"
config/features=PackedStringArray("4.7", "Forward Plus")
run/max_fps=60
config/icon="res://icon.svg"

[audio]

buses/default_bus_layout="uid://cgd5hs18bevdo"

[debug]

gdscript/warnings/unused_variable=0
gdscript/warnings/unused_local_constant=0
gdscript/warnings/unused_private_class_variable=0
gdscript/warnings/unused_parameter=0
gdscript/warnings/unused_signal=0
gdscript/warnings/integer_division=0

[display]

window/size/viewport_width=192
window/size/viewport_height=108
window/size/always_on_top=true
window/size/window_width_override=1920
window/size/window_height_override=1080
window/stretch/mode="viewport"
window/stretch/aspect="keep_height"
window/handheld/orientation=4
window/vsync/vsync_mode=0

[file_customization]

folder_colors={
"res://audio/": "purple",
"res://audio/analog/": "red",
"res://audio/drums/": "yellow",
"res://audio/modular/": "green",
"res://audio/modular/modules/": "green",
"res://audio/modular/node_layouts/": "teal",
"res://audio/modular_extension/": "green",
"res://audio/sampler/": "blue",
"res://audio/sampler/samples/": "teal",
"res://audio/tonal/": "purple",
"res://audio/tonal/bend_bindings/": "pink",
"res://audio/tonal/chord_transformation/": "blue",
"res://audio/tonal/composition/": "red",
"res://audio/tonal/inspector/": "red",
"res://core/": "gray",
"res://editor/": "pink",
"res://editor/analog/": "red",
"res://editor/drums/": "yellow",
"res://editor/modular/": "green",
"res://editor/sampler/": "blue",
"res://editor/tonal/": "purple",
"res://interface/": "teal",
"res://interface/art/": "red",
"res://interface/font/": "orange",
"res://interface/icon/": "yellow",
"res://interface/interface_box/": "green",
"res://interface/interface_button/": "green",
"res://interface/styles/": "blue"
}

